# Copy this file to .env and fill in real values. Never commit .env.

# --- Neo4j (self-hosted via docker-compose, with GDS plugin enabled) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argus_dev_password

# --- Redis (cache + async job status) ---
# Port 6379 by default. If another Redis is already running on this machine,
# set REDIS_PORT (used by docker-compose.yml) and update REDIS_URL to match.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Optional local AI assistant (see ARGUS_PLAN.md Phase 10) ---
# ARGUS works fully offline without this. If you have Ollama running
# locally (https://ollama.com) with a small model pulled (e.g. `ollama
# pull llama3.2:3b`), the "Ask ARGUS" panel activates automatically.
# Otherwise leave this as-is — every other feature is unaffected.
OLLAMA_BASE_URL=http://localhost:11434

# --- PostgreSQL: identity, authorization, audit ---
# Port 55432, not 5432: many machines already run their own PostgreSQL, and
# competing for the default port produces authentication errors that read as
# credential bugs.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=argus

# Migrations run as the superuser to create the schema, the append-only audit
# triggers, and the least-privilege application role.
POSTGRES_SUPERUSER=argus_admin
POSTGRES_SUPERUSER_PASSWORD=argus_dev_password

# The application connects as this role, which holds INSERT and SELECT on
# audit_events and nothing else. That is what makes the audit log survive
# compromise of the API. Do not point the app at the superuser.
POSTGRES_APP_USER=argus_app
POSTGRES_APP_PASSWORD=argus_dev_app_password

# --- Sessions ---
# Set true wherever ARGUS is reachable over a network. False is for local http
# development only.
SESSION_COOKIE_SECURE=false

# --- Ingestion ---
# Every filesystem connector is confined beneath this directory. Connector
# config is administrator-supplied and therefore trusted-ish, which is not a
# reason to let a config string read /etc or a mounted secret.
ARGUS_INGEST_ROOT=/var/lib/argus/ingest

# Connector URLs resolving to private, loopback or link-local addresses are
# refused by default — a feed URL pointing at the cloud metadata endpoint is
# server-side request forgery with extra steps. Set true only for a genuinely
# internal feed, where its presence in the environment is visible.
# ARGUS_ALLOW_PRIVATE_INGEST_HOSTS=false

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# The only public value the frontend needs. There is deliberately no token here:
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time, so a
# credential placed here is published to every visitor. Authentication is an
# httpOnly session cookie that JavaScript cannot read.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Create the first account with:
#   cd backend && python -m app.cli create-user --username you --role administrator
