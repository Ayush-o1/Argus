# Copy this file to .env and fill in real values. Never commit .env.

# --- Neo4j (self-hosted via docker-compose, with GDS plugin enabled) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argus_dev_password

# --- Redis (cache + async job status) ---
REDIS_URL=redis://localhost:6379/0

# --- Optional local AI assistant (see ARGUS_PLAN.md Phase 10) ---
# ARGUS works fully offline without this. If you have Ollama running
# locally (https://ollama.com) with a small model pulled (e.g. `ollama
# pull llama3.2:3b`), the "Ask ARGUS" panel activates automatically.
# Otherwise leave this as-is — every other feature is unaffected.
OLLAMA_BASE_URL=http://localhost:11434

# --- API auth (single-user demo system, see ARGUS_PLAN.md Phase 11) ---
ARGUS_API_TOKEN=argus_dev_token

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_ARGUS_API_TOKEN=argus_dev_token
