# Copy this file to .env and fill in real values. Never commit .env.

# --- Neo4j (self-hosted via docker-compose, with GDS plugin enabled) ---
# For Neo4j AuraDB, NEO4J_URI is the `neo4j+s://<dbid>.databases.neo4j.io`
# value Aura gives you at creation (the `+s` enables TLS; the driver reads
# encryption from the URI scheme, so no other setting is needed for that).
# Aura does not include the Graph Data Science plugin on its lower tiers —
# verify against your Aura plan before relying on it. Without GDS, pagerank,
# betweenness, louvain and the node2vec "similar entities" algorithm are
# unavailable; risk-propagation, cycle-detection and anomaly detection are
# plain Cypher / Python-side and unaffected, as is everything outside
# Analytics (graph reads, correlation's own scoring, entity resolution).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argus_dev_password

# --- Redis (cache + async job status) ---
# Port 6379 by default. If another Redis is already running on this machine,
# set REDIS_PORT (used by docker-compose.yml) and update REDIS_URL to match.
# For Upstash, set REDIS_URL to the `rediss://...` connection string from the
# Upstash console (the extra "s" is TLS — the client detects it from the
# scheme automatically, no other setting needed). The app's Redis usage is
# SET/GET/SCAN with TTLs only — no pub/sub, Lua, or multi-database SELECT —
# which is within every Upstash tier including Free.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Optional local AI assistant (see ARGUS_PLAN.md Phase 10) ---
# ARGUS works fully offline without this. If you have Ollama running
# locally (https://ollama.com) with a small model pulled (e.g. `ollama
# pull llama3.2:3b`), the "Ask ARGUS" panel activates automatically.
# Otherwise leave this as-is — every other feature is unaffected.
OLLAMA_BASE_URL=http://localhost:11434

# --- PostgreSQL: identity, authorization, audit ---
# Port 55432, not 5432: many machines already run their own PostgreSQL, and
# competing for the default port produces authentication errors that read as
# credential bugs.
#
# For Neon: there is no single DATABASE_URL here by design — the app
# deliberately migrates as an admin-ish role and then serves requests as a
# separate least-privilege role it creates for itself (see
# POSTGRES_APP_USER below), so the audit log survives a compromise of the API
# itself. Set POSTGRES_HOST to your Neon hostname, POSTGRES_PORT=5432,
# POSTGRES_DB to your Neon database name, and POSTGRES_SUPERUSER /
# POSTGRES_SUPERUSER_PASSWORD to the role Neon gave you when you created the
# project (that role needs CREATEROLE to run migration 002, which creates
# POSTGRES_APP_USER — verify this against your Neon role's actual grants).
# Also set POSTGRES_SSLMODE=require below; Neon refuses plaintext connections.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=argus

# Migrations run as the superuser to create the schema, the append-only audit
# triggers, and the least-privilege application role.
POSTGRES_SUPERUSER=argus_admin
POSTGRES_SUPERUSER_PASSWORD=argus_dev_password

# The application connects as this role, which holds INSERT and SELECT on
# audit_events and nothing else. That is what makes the audit log survive
# compromise of the API. Do not point the app at the superuser.
# On Neon, migration 002 creates this role itself the first time the app
# starts — you do not create it yourself, just choose the password here.
POSTGRES_APP_USER=argus_app
POSTGRES_APP_PASSWORD=argus_dev_app_password

# --- Sessions ---
# Set true wherever ARGUS is reachable over a network. False is for local http
# development only.
SESSION_COOKIE_SECURE=false

# "strict" is correct whenever the frontend and backend share a registrable
# domain (a different port is still the same *site*, which is why local dev
# works as-is). Set to "none" when they don't — e.g. a Vercel frontend
# (*.vercel.app) talking to a Render backend (*.onrender.com) are different
# sites, and a Strict cookie is never sent on that cross-site request: login
# would appear to succeed while the browser silently drops the cookie, so
# every request after looks unauthenticated. "none" requires
# SESSION_COOKIE_SECURE=true — the app refuses to start otherwise, since
# browsers reject SameSite=None without Secure.
SESSION_COOKIE_SAMESITE=strict

# --- PostgreSQL over TLS (Neon, RDS, or any managed provider) ---
# Empty/unset for the local docker-compose Postgres, which has no certificate
# and speaks plain TCP. A managed provider both requires TLS and refuses a
# plaintext connection, so deploying against one needs this set to at least
# "require" (asyncpg parses `sslmode` directly from the connection string).
POSTGRES_SSLMODE=

# --- Ingestion ---
# Every filesystem connector is confined beneath this directory. Connector
# config is administrator-supplied and therefore trusted-ish, which is not a
# reason to let a config string read /etc or a mounted secret.
ARGUS_INGEST_ROOT=/var/lib/argus/ingest

# Connector URLs resolving to private, loopback or link-local addresses are
# refused by default — a feed URL pointing at the cloud metadata endpoint is
# server-side request forgery with extra steps. Set true only for a genuinely
# internal feed, where its presence in the environment is visible.
# ARGUS_ALLOW_PRIVATE_INGEST_HOSTS=false

# --- CORS ---
# Comma-separated exact origins — never "*", which the CORS spec forbids
# combining with credentials (the session cookie needs allow_credentials=True
# to be sent cross-origin at all). In production this is your Vercel
# deployment's actual origin, e.g. https://<argus-vercel-domain>.vercel.app —
# include both the production domain and any preview-deployment domain you
# rely on, since each is a distinct origin.
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
# The only public value the frontend needs. There is deliberately no token here:
# NEXT_PUBLIC_* variables are inlined into the client bundle at build time, so a
# credential placed here is published to every visitor. Authentication is an
# httpOnly session cookie that JavaScript cannot read.
# In production, set this to your Render backend's public URL, e.g.
# https://argus-backend.onrender.com — set as a Vercel project environment
# variable (Project Settings → Environment Variables), not in a committed file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Create the first account with:
#   cd backend && python -m app.cli create-user --username you --role administrator
